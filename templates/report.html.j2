{% extends "base.html.j2" %}
{% block title %}GitHub 每日热榜 · {{ report_date }}{% endblock %}
{% block content %}
<header>
  <div class="site-head">
    <h1>GitHub 每日热榜</h1>
    <span class="date-badge">{{ report_date }}</span>
  </div>
  <p class="head-note">
    数据窗口：约过去 24 小时（来源 <a href="{{ source_url }}">GitHub Trending · Daily</a>） ·
    项目描述保留英文原文，附 Agnes 3.0 Flash 自动中文翻译 · 生成时间：{{ generated_at }}
  </p>
</header>

<section class="stats">
  <div class="stat"><div class="num">{{ repo_count }}</div><div class="label">上榜项目</div></div>
  <div class="stat"><div class="num">{{ total_stars_today | thousands }}</div><div class="label">新增 Star 合计</div></div>
  <div class="stat"><div class="num">{{ lang_stats | length }}</div><div class="label">涉及语言</div></div>
  <div class="stat"><div class="num">#1</div><div class="label">今日榜首：{{ top_repo_name }}</div></div>
</section>

{% if lang_stats %}
<section class="langbar">
  <div class="bar">
    {% for lang in lang_stats %}
    <div class="seg" style="width: {{ lang.pct }}%; background: {{ lang.color }};" title="{{ lang.name }} {{ lang.count }} 个"></div>
    {% endfor %}
  </div>
  <div class="legend">
    {% for lang in lang_stats %}
    <span><span class="dot" style="background: {{ lang.color }};"></span>{{ lang.name }} · {{ lang.count }}</span>
    {% endfor %}
  </div>
</section>
{% endif %}

<section class="repo-list">
  {% for r in repos %}
  <article class="repo{% if r.rank <= 3 %} top{% endif %}">
    <div class="rank">{{ "%02d" | format(r.rank) }}</div>
    <div class="repo-body">
      <div class="repo-title"><a href="{{ r.url }}">{{ r.full_name }}</a></div>
      <p class="desc">{{ r.description or "（仓库未提供描述）" }}</p>
      {% if r.description_zh %}<p class="desc-zh">译：{{ r.description_zh }}</p>{% endif %}
      <div class="meta">
        {% if r.language %}<span class="lang"><span class="dot" style="background: {{ r.language_color }};"></span>{{ r.language }}</span>{% endif %}
        <span class="stars">★ {{ r.stars | thousands }}</span>
        {% if r.stars_today %}<span class="today">+{{ r.stars_today | thousands }} today</span>{% endif %}
        {% if r.forks %}<span>⑂ {{ r.forks | thousands }}</span>{% endif %}
        {% if r.open_issues %}<span>◉ {{ r.open_issues | thousands }} open issues</span>{% endif %}
        {% if r.license %}<span>{{ r.license }}</span>{% endif %}
        {% if r.homepage %}<span><a href="{{ r.homepage }}">主页</a></span>{% endif %}
      </div>
      {% if r.topics %}
      <div class="topics">{% for t in r.topics[:6] %}<span>#{{ t }}</span>{% endfor %}</div>
      {% endif %}
    </div>
  </article>
  {% endfor %}
</section>

{% if developers %}
<section class="dev-list">
  <div class="sec-head">
    <h2>今日热门开发者</h2>
    <span class="sec-sub">来源 <a href="https://github.com/trending/developers?since=daily">Trending Developers</a></span>
  </div>
  <div class="dev-grid">
    {% for d in developers[:12] %}
    <div class="dev-card">
      {% if d.avatar %}<img class="dev-avatar" src="{{ d.avatar }}" alt="@{{ d.username }}" loading="lazy">{% endif %}
      <div class="dev-info">
        <div class="dev-name"><a href="https://github.com/{{ d.username }}">{{ d.name or d.username }}</a></div>
        <div class="dev-user">@{{ d.username }}</div>
        {% if d.repo %}<div class="dev-repo">🔥 <a href="https://github.com/{{ d.repo }}">{{ d.repo }}</a></div>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if insights and (insights.growth or insights.new_stars or insights.streak) %}
<section class="insights">
  <div class="sec-head">
    <h2>数据洞察</h2>
    <span class="sec-sub">基于 {{ insights.total_days }} 期历史存档自动计算</span>
  </div>
  <div class="insight-grid">
    {% if insights.growth %}
    <div class="insight-col">
      <h3>近 {{ insights.window_days }} 日 Star 增长 Top5</h3>
      <ol class="insight-list">
        {% for g in insights.growth %}<li><span class="i-name">{{ g.full_name }}</span><span class="i-val">+{{ g.delta | thousands }}</span></li>{% endfor %}
      </ol>
    </div>
    {% endif %}
    {% if insights.new_stars %}
    <div class="insight-col">
      <h3>近 {{ insights.window_days }} 日新增 Star 合计 Top5</h3>
      <ol class="insight-list">
        {% for g in insights.new_stars %}<li><span class="i-name">{{ g.full_name }}</span><span class="i-val">+{{ g.delta | thousands }}</span></li>{% endfor %}
      </ol>
    </div>
    {% endif %}
    {% if insights.streak %}
    <div class="insight-col">
      <h3>连续上榜 Top5</h3>
      <ol class="insight-list">
        {% for g in insights.streak %}<li><span class="i-name">{{ g.full_name }}</span><span class="i-val">{{ g.days }} 天</span></li>{% endfor %}
      </ol>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

<section class="archive-block">
  <div class="arch-head">
    <h2>往期回顾</h2>
    <a class="arch-all" href="{{ base_path }}/archive/">查看全部归档 →</a>
  </div>
  {% if archive %}
  <ul class="arch-list">
    {% for item in archive[:10] %}
    <li>
      <a class="arch-date" href="{{ base_path }}/{{ item.href }}">{{ item.date }}</a>
      {% if item.top_repo %}<span class="arch-top">榜首 {{ item.top_repo }}</span>{% endif %}
      <span class="arch-count">{{ item.count }} 个项目</span>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="head-note">暂无往期数据，明天起就会出现。</p>
  {% endif %}
</section>

<footer class="site-foot">
  <div>由 GitHub Actions 每日 01:00（北京时间）自动生成 · 榜单数量以 GitHub Trending 实际返回为准</div>
  {% if archive %}
  <div class="archive">更多往期：
    {% for item in archive %}<a href="{{ base_path }}/{{ item.href }}">{{ item.date }}</a>{% endfor %}
    <a href="{{ base_path }}/archive/">全部归档</a>
  </div>
  {% endif %}
</footer>
{% endblock %}
