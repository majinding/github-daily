<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}GitHub 每日热榜{% endblock %}</title>
<style>
:root {
  --bg: #f6f8fa; --card: #ffffff; --text: #1f2328; --muted: #59636e;
  --border: #d1d9e0; --accent: #0969da; --star: #9a6700; --today: #cf222e;
  --chip: #eff2f5; --code: #ddf4ff;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117; --card: #161b22; --text: #e6edf3; --muted: #9198a1;
    --border: #30363d; --accent: #4493f8; --star: #d4a72c; --today: #f85149;
    --chip: #21262d; --code: #121d2f;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
  line-height: 1.6;
}
.wrap { max-width: 880px; margin: 0 auto; padding: 28px 18px 60px; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

.site-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 14px; margin-bottom: 6px; }
.site-head h1 { font-size: 1.5rem; margin: 0; letter-spacing: .5px; }
.date-badge {
  background: var(--code); color: var(--accent); border: 1px solid var(--border);
  border-radius: 999px; padding: 2px 12px; font-size: .85rem; font-weight: 600;
}
.head-note { color: var(--muted); font-size: .82rem; margin: 0 0 22px; }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 14px; }
.stat {
  background: var(--card); border: 1px solid var(--border); border-radius: 10px;
  padding: 12px 16px;
}
.stat .num { font-size: 1.35rem; font-weight: 700; }
.stat .label { font-size: .78rem; color: var(--muted); }

.langbar {
  background: var(--card); border: 1px solid var(--border); border-radius: 10px;
  padding: 14px 16px; margin-bottom: 26px;
}
.langbar .bar { display: flex; height: 10px; border-radius: 6px; overflow: hidden; margin-bottom: 10px; }
.langbar .seg { height: 100%; }
.langbar .legend { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: .78rem; color: var(--muted); }
.langbar .legend .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 5px; vertical-align: baseline; }

.repo {
  display: flex; gap: 16px; background: var(--card); border: 1px solid var(--border);
  border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;
}
.repo:hover { border-color: var(--accent); }
.rank {
  font-size: 1.5rem; font-weight: 800; color: var(--muted); min-width: 44px;
  text-align: center; font-variant-numeric: tabular-nums; padding-top: 2px;
}
.repo.top .rank { color: var(--today); }
.repo-body { flex: 1; min-width: 0; }
.repo-title { font-size: 1.05rem; font-weight: 700; word-break: break-all; }
.repo-title a { color: var(--text); }
.repo-title a:hover { color: var(--accent); }
.desc { margin: 6px 0 10px; color: var(--muted); font-size: .92rem; }
.meta { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: .82rem; color: var(--muted); align-items: center; }
.meta .lang .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 5px; }
.meta .today { color: var(--today); font-weight: 700; }
.meta .stars { color: var(--star); font-weight: 600; }
.topics { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 6px; }
.topics span {
  background: var(--chip); border-radius: 999px; padding: 1px 10px;
  font-size: .74rem; color: var(--muted);
}

.site-foot { margin-top: 34px; padding-top: 18px; border-top: 1px solid var(--border); color: var(--muted); font-size: .82rem; }
.site-foot .archive { margin-top: 8px; }
.site-foot .archive a { margin-right: 12px; white-space: nowrap; }

.page-list { list-style: none; margin: 0; padding: 0; }
.page-list li {
  background: var(--card); border: 1px solid var(--border); border-radius: 10px;
  padding: 12px 16px; margin-bottom: 10px; display: flex; justify-content: space-between;
}
.page-list li a { font-weight: 600; }
.page-list li .count { color: var(--muted); font-size: .82rem; }
</style>
</head>
<body>
<main class="wrap">
{% block content %}{% endblock %}
</main>
</body>
</html>
